      "seed_01_predictions.csv",
      "seed_02_predictions.csv",
      "seed_03_predictions.csv",
      "seed_04_predictions.csv",
      "seed_05_predictions.csv",
      "seed_06_predictions.csv",
      "seed_07_predictions.csv",
      "seed_08_predictions.csv",
      "seed_09_predictions.csv",
      "seed_42_predictions.csv"
    ],
    "seed_count": 11,
    "prediction_rows": 5784,
    "unique_sample_count": 1728,
    "pooling": "equal-weight prediction rows across held-out seed splits"
  },
  "validation_metrics": {
