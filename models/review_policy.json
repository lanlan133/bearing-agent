{
  "version": "2.0",
  "method": "paper_stacking_multi_seed_holdout_review",
  "model_name": "MSM-ADASYN-Stacking",
  "probability_field": "stacking_probability",
  "base_threshold": 0.5,
  "lower_threshold": 0.01,
